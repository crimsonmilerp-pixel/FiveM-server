# =============================================================
#  secrets.cfg.example
#  The real file is "secrets.cfg". It sits next to server.cfg on the server
#  and on Vinny's PC, and it is listed in .gitignore so it never goes to GitHub.
#  server.cfg loads it with the line:  exec secrets.cfg
#
#  The FiveM license key is NOT in here. Nodecraft keeps it in
#  nodecraft_config.cfg (Nodecraft panel -> Game Settings).
# =============================================================

# Database connection (Nodecraft panel -> Databases tab -> Show)
set mysql_connection_string "mysql://USER:PASSWORD@HOST/DATABASE"

# Any future tokens, webhooks, or API keys go here too. For example:
# set SCREENSHOT_BASIC_TOKEN "..."
# set inventory:webhook "https://discord.com/api/webhooks/..."
